#!/usr/bin/env bash
# This script displays "To infinity and beyond" indefinitely
# and prints "I am invincible!!!" when it receives a SIGTERM

# Define a signal handler function
handle_sigterm() {
    echo "I am invincible!!!"
}

# Trap the SIGTERM signal and call the handler
trap 'handle_sigterm' SIGTERM

# Infinite loop
while true; do
    echo "To infinity and beyond"
    sleep 2
done
